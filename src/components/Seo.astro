---
/** Metadatos SEO y Open Graph por página. */
import { getImage } from 'astro:assets';
import type { ImagenCMS } from '../lib/cms';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: ImagenCMS | null;
  tipo?: 'website' | 'article';
  noIndexar?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  nombreSitio: string;
}
const { titulo, descripcion, imagen, tipo = 'website', noIndexar = false, jsonLd, nombreSitio } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
let ogImagen: string | undefined;
if (imagen?.url) {
  const img = await getImage({ src: imagen.url, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
  ogImagen = new URL(img.src, Astro.site).toString();
}
---
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noIndexar && <meta name="robots" content="noindex" />}
<meta property="og:type" content={tipo} />
<meta property="og:site_name" content={nombreSitio} />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
{ogImagen && <meta property="og:image" content={ogImagen} />}
{ogImagen && <meta property="og:image:width" content="1200" />}
{ogImagen && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={ogImagen ? 'summary_large_image' : 'summary'} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
