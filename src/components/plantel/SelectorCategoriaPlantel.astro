---
interface Props { categorias: { nombre: string; slug: string }[]; actual?: string; base: string; etiqueta?: string }
const { categorias, actual, base, etiqueta = 'Categorías' } = Astro.props;
---
<nav class="selector-cat" aria-label={etiqueta}>
  <ul>
    {categorias.map((c) => (
      <li>
        <a href={`${base}/${c.slug}`} aria-current={c.slug === actual ? 'page' : undefined}>
          {c.slug === actual && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
          )}
          {c.nombre}
        </a>
      </li>
    ))}
  </ul>
</nav>
