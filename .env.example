# Copiar como .env y completar. Ninguno de estos valores es secreto:
# el dataset de Sanity es público y de solo lectura.

# ID del proyecto de Sanity (sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
# Dataset publicado
PUBLIC_SANITY_DATASET=production
# URL pública del sitio (canonical, Open Graph, sitemap)
SITE_URL=https://bocadeserodino.pages.dev
